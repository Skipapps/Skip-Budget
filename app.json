{
  "expo": {
    "name": "Skip Budget",
    "slug": "skip-budget",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skipbudget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.skipapps.skip.budget",
      "appleTeamId": "2YDDY7H6XP",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Skip Budget uses the camera to scan your receipts. Scans are read on your device and never uploaded.",
        "NSPhotoLibraryUsageDescription": "Skip Budget reads receipts you pick from your photos. They are processed on your device."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.skipapps.skip.budget",
      "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#1B181F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.454715210371-8kpjr204d615ejo3fi58814e49o79voc"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Skip uses Face ID to unlock your budget when you open the app."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "skip-budget",
          "project": "react-native"
        }
      ],
      "expo-notifications",
      "@bacons/apple-targets",
      [
        "./plugins/with-signing.js",
        {
          "teamId": "2YDDY7H6XP"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
