# Public config only. Everything prefixed EXPO_PUBLIC_ is inlined into the app
# bundle and is readable by anyone who downloads the app — never put a
# service-role key, a Resend API key, or any other secret here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: leave blank to disable crash reporting in development.
EXPO_PUBLIC_SENTRY_DSN=

# Google Sign-In. Both are OAuth client ids from Google Cloud Console and are
# public by design — they ship inside the app binary whatever we do. Leave the
# iOS one blank to fall back to the browser sign-in flow.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Brandfetch Logo Link. A client id, not an API key — it is designed for
# client-side embedding, so shipping it in the bundle is the intended use.
# Leave blank to render monogram tiles instead of real logos.
EXPO_PUBLIC_BRANDFETCH_CLIENT_ID=
